# 2. Retomar tracao a 10 m/s (0.10 A/ps)
reset_timestep  0
timestep        0.001

variable        A_area equal $(lx*ly)
variable        A_area equal 166.84765333027911538
variable        z_bmax equal $(bound(bot_fix,zmax))
variable        z_bmax equal -201.10699999999999932
variable        z_tmin equal $(bound(top_fix,zmin))
variable        z_tmin equal 249.41599999999999682

velocity        bot_fix set 0.0 0.0 0.0
velocity        top_fix set 0.0 0.0 0.10
velocity        mobile  ramp vz 0.0 0.10 z ${z_bmax} ${z_tmin} sum yes units box
velocity        mobile  ramp vz 0.0 0.10 z -201.107 ${z_tmin} sum yes units box
velocity        mobile  ramp vz 0.0 0.10 z -201.107 249.416 sum yes units box

compute         T_xy   mobile temp/partial 1 1 0
compute         T_all  mobile temp
compute         ftop   top_fix reduce sum fx fy fz
compute         fbot   bot_fix reduce sum fx fy fz

fix             1 mobile nvt temp 300.0 300.0 0.1
fix_modify      1 temp T_xy
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1423)
fix             2 top_fix move linear 0.0 0.0 0.10 units box

variable        u_grip equal ${u0}+step*dt*0.10
variable        u_grip equal 48+step*dt*0.10
variable        tn_top equal -c_ftop[3]/v_A_area*160.2176634
variable        tn_bot equal  c_fbot[3]/v_A_area*160.2176634
variable        tn_avg equal  0.5*(v_tn_top+v_tn_bot)

