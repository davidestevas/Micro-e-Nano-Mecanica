# ==============================================================================
# Correcao Passo 1.3b: apenas casos de corte (+/- 1.0% xy) com "units box"
# Casos: 3 = +gxy, 4 = -gxy
# ==============================================================================
variable        idx index 3 4
label           loopShear

  clear
  units           metal
  dimension       3
  boundary        p p p
  atom_style      atomic

  lattice         fcc 3.631868
  region          box prism 0 8 0 8 0 8 0.0 0.0 0.0
  create_box      1 box
  create_atoms    1 box
  mass            1 63.546

  pair_style      eam/alloy
  pair_coeff      * * ../00_potentials/Cu_mishin1.eam.alloy Cu

  neighbor        2.0 bin
  neigh_modify    every 1 delay 0 check yes

  if "${idx} == 3" then "change_box all xy delta $(0.01*ly) remap units box"
  if "${idx} == 4" then "change_box all xy delta $(-0.01*ly) remap units box"

  timestep        0.001
  variable        seed equal 100000+111111*${idx}
  velocity        all create 600.0 ${seed} mom yes rot yes dist gaussian

  fix             1 all nvt temp 300.0 300.0 0.1
  thermo          10000
  thermo_style    custom step temp pe pxx pyy pzz pyz pxz pxy

  # 10 ps equilibracao (descartado)
  run             10000

  # 50 ps producao
  reset_timestep  0
  variable        sxx equal -pxx/1.0e4
  variable        syy equal -pyy/1.0e4
  variable        szz equal -pzz/1.0e4
  variable        syz equal -pyz/1.0e4
  variable        sxz equal -pxz/1.0e4
  variable        sxy equal -pxy/1.0e4
  variable        T   equal temp

  fix             out all ave/time 1 10 10 v_sxx v_syy v_szz v_syz v_sxz v_sxy v_T file stress_300K_case${idx}.dat
  run             50000

  unfix           out
  unfix           1

next            idx
jump            SELF loopShear
