variable        a0    equal $(lx/v_n)
variable        a0    equal 3.6149250658880824894
variable        Nat0  equal $(atoms)
variable        Nat0  equal 864
variable        Eref0 equal $(pe)
variable        Eref0 equal -3058.7486372971716264
