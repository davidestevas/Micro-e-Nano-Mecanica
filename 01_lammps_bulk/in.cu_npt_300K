# ==============================================================================
# Passo 1.3a: Equilibracao NPT a 300 K e P = 0 para obter a(300 K)
# Caixa 8x8x8 (2048 atomos), dt = 1.0 fs, 40 ps totais (10 ps eq + 30 ps prod)
# ==============================================================================
units           metal
dimension       3
boundary        p p p
atom_style      atomic

variable        n equal 8

lattice         fcc 3.614925
region          box block 0 ${n} 0 ${n} 0 ${n}
create_box      1 box
create_atoms    1 box
mass            1 63.546

pair_style      eam/alloy
pair_coeff      * * ../00_potentials/Cu_mishin1.eam.alloy Cu

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001
velocity        all create 600.0 492845 mom yes rot yes dist gaussian

fix             1 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0

variable        t_ps  equal step*dt
variable        T     equal temp
variable        P_GPa equal press/1.0e4
variable        a_A   equal lx/v_n
variable        PE    equal pe

fix             out all print 20 "${t_ps} ${T} ${P_GPa} ${a_A} ${PE}" file npt_300K_8x8x8.dat screen no title "# t_ps Temp_K P_GPa a_A PE_eV"

thermo          5000
thermo_style    custom step temp press lx pe
run             40000
