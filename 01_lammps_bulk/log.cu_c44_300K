LAMMPS (23 Jun 2022 - Update 1)
# ==============================================================================
# Correcao Passo 1.3b: apenas casos de corte (+/- 1.0% xy) com "units box"
# Casos: 3 = +gxy, 4 = -gxy
# ==============================================================================
variable        idx index 3 4
label           loopShear

  clear
  units           metal
  dimension       3
  boundary        p p p
  atom_style      atomic

  lattice         fcc 3.631868
Lattice spacing in x,y,z = 3.631868 3.631868 3.631868
  region          box prism 0 8 0 8 0 8 0.0 0.0 0.0
  create_box      1 box
Created triclinic box = (0 0 0) to (29.054944 29.054944 29.054944) with tilt (0 0 0)
  1 by 1 by 1 MPI processor grid
  create_atoms    1 box
Created 2048 atoms
  using lattice units in triclinic box = (0 0 0) to (29.054944 29.054944 29.054944) with tilt (0 0 0)
  create_atoms CPU = 0.001 seconds
  mass            1 63.546

  pair_style      eam/alloy
  pair_coeff      * * ../00_potentials/Cu_mishin1.eam.alloy Cu
Reading eam/alloy potential file ../00_potentials/Cu_mishin1.eam.alloy with DATE: 2007-10-12

  neighbor        2.0 bin
  neigh_modify    every 1 delay 0 check yes

  if "${idx} == 3" then "change_box all xy delta $(0.01*ly) remap units box"
change_box all xy delta $(0.01*ly) remap units box
change_box all xy delta 0.29054943999999999216 remap units box
Changing box ...
  triclinic box = (0 0 0) to (29.054944 29.054944 29.054944) with tilt (0.29054944 0 0)
  if "${idx} == 4" then "change_box all xy delta $(-0.01*ly) remap units box"

  timestep        0.001
  variable        seed equal 100000+111111*${idx}
  variable        seed equal 100000+111111*3
  velocity        all create 600.0 ${seed} mom yes rot yes dist gaussian
  velocity        all create 600.0 433333 mom yes rot yes dist gaussian

  fix             1 all nvt temp 300.0 300.0 0.1
  thermo          10000
  thermo_style    custom step temp pe pxx pyy pzz pyz pxz pxy

  # 10 ps equilibracao (descartado)
  run             10000
