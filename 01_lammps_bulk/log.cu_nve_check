unfix           out1
unfix           nve1

# 3. Corrida microcanonica (NVE) 20 ps com dt = 0.5 fs a partir do mesmo estado
clear
read_restart    restart.nve_init
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
