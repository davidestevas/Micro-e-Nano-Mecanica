unfix           eq

# Zerar momento linear antes de iniciar NVE
velocity        all zero linear
write_restart   restart.nve_init
System init for write_restart ...

# 2. Corrida microcanonica (NVE) 20 ps com dt = 1.0 fs
reset_timestep  0
timestep        0.001
fix             nve1 all nve

variable        t_ps  equal step*dt
variable        T     equal temp
variable        PE    equal pe
variable        KE    equal ke
variable        Etot  equal etotal
variable        px_cm equal vcm(all,x)
variable        py_cm equal vcm(all,y)
variable        pz_cm equal vcm(all,z)

fix             out1 all print 10 "${t_ps} ${T} ${PE} ${KE} ${Etot} ${px_cm} ${py_cm} ${pz_cm}" file nve_300K_dt1p0.dat screen no title "# t_ps Temp_K PE_eV KE_eV Etot_eV vcmx vcmy vcmz"

thermo          5000
thermo_style    custom step temp pe ke etotal
run             20000
